<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UsageMonitor</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.1" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.1" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
    <!-- Windows launch-at-login (HKCU Run key). Guarded by [SupportedOSPlatform] +
         OperatingSystem.IsWindows(); on other RIDs the API surface is present but unused. -->
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\usage-monitor.ico" />
  </ItemGroup>

  <!-- Generate BuildInfo into obj/ (outside the default Compile glob) and add it to
       @(Compile) from within the target, so a clean checkout compiles on the first
       build. Writing into the source tree fails the first build because MSBuild fixes
       the Compile item list before this target runs. -->
  <Target Name="GenerateBuildInfo" BeforeTargets="BeforeCompile;CoreCompile">
    <Exec Command="git rev-parse --short HEAD"
          ConsoleToMSBuild="true"
          ContinueOnError="true"
          IgnoreExitCode="true"
          EchoOff="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommitSha" />
    </Exec>
    <PropertyGroup>
      <_GitCommitSha Condition="'$(_GitCommitSha)' == ''">unknown</_GitCommitSha>
      <_BuildDateUtc>$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"))</_BuildDateUtc>
      <_BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</_BuildInfoFile>
    </PropertyGroup>
    <ItemGroup>
      <_BuildInfoLine Include="// Auto-generated by the GenerateBuildInfo MSBuild target. Do not edit by hand." />
      <_BuildInfoLine Include="namespace UsageMonitor%3B" />
      <_BuildInfoLine Include="public static class BuildInfo" />
      <_BuildInfoLine Include="{" />
      <_BuildInfoLine Include="    public static string CommitSha { get%3B } = &quot;$(_GitCommitSha)&quot;%3B" />
      <_BuildInfoLine Include="    public static string BuildDate { get%3B } = &quot;$(_BuildDateUtc)&quot;%3B" />
      <_BuildInfoLine Include="}" />
    </ItemGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(_BuildInfoFile)"
                      Lines="@(_BuildInfoLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_BuildInfoFile)" />
    </ItemGroup>
  </Target>

</Project>
