            <Border x:Name="IconOnlyView"
                    IsVisible="False"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Width="54"
                    Height="54"
                    Background="#E6181818"
                    CornerRadius="16"
                    BorderBrush="#404040"
                    BorderThickness="1"
                    Padding="6">
                <Grid>
                    <Button x:Name="RestoreIconButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="Restore full">
                        <Image x:Name="RestoreIconImage"
                               Width="26"
                               Height="26"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Button>
                    <Border x:Name="IconOnlyUpdateDot"
                            Width="10" Height="10"
                            CornerRadius="5"
                            Background="#4CAF50"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            IsVisible="False"
                            ToolTip.Tip="Update available" />
                </Grid>
            </Border>

            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        Spacing="4">
                <Button x:Name="UpdateButton"
                        Width="24" Height="24"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="12"
                        Padding="0"
                        IsVisible="False"
                        ToolTip.Tip="Update available - click to update and restart">
                    <TextBlock Text="&#x21BB;"
                               FontSize="16"
                               Foreground="#4CAF50"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>

                <Button x:Name="CompactButton"
                        Width="28" Height="24"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="12"
                        Padding="0"
                        ToolTip.Tip="Compact AI view">
                    <TextBlock Text="AI"
                               FontSize="10"
                               Foreground="#B0B0B0"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>

                <Button x:Name="IconOnlyButton"
                        Width="24" Height="24"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="12"
                        Padding="0"
                        ToolTip.Tip="Icon only view">
                    <Image x:Name="IconOnlyButtonImage"
                           Width="14"
                           Height="14" />
                </Button>

                <Button x:Name="CloseButton"
                        Width="24" Height="24"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="13"
                        Padding="0"
                        ToolTip.Tip="Close">
                    <Path Data="M18.3,5.71 L12,12 L5.71,5.71 M5.71,18.29 L12,12 L18.3,18.29"
                          Stroke="#888888"
                          StrokeThickness="2"
                          Width="14" Height="14"
                          Stretch="Uniform" />
                </Button>
            </StackPanel>

        </Grid>
    </Border>
</Window>
