<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UsageMonitor.UsagePopup"
        Title="Usage Monitor"
        Width="340"
        Height="680"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

    <Border Background="#E6181818"
            CornerRadius="12"
            BorderBrush="#404040"
            BorderThickness="1"
            Padding="0">

        <Grid RowDefinitions="Auto,*">

            <!-- Title Bar -->
            <Border Grid.Row="0"
                    Background="#252525"
                    CornerRadius="12,12,0,0"
                    Padding="14,10">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="Usage Monitor"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#E0E0E0"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            x:Name="CloseButton"
                            Width="28" Height="28"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="14"
                            Padding="0"
                            ToolTip.Tip="Close">
                        <Path Data="M18.3,5.71 L12,12 L5.71,5.71 M5.71,18.29 L12,12 L18.3,18.29"
                              Stroke="#888888"
                              StrokeThickness="2"
                              Width="14" Height="14"
                              Stretch="Uniform" />
                    </Button>
                </Grid>
            </Border>

            <!-- Content Area -->
            <ScrollViewer Grid.Row="1" Padding="14,10,14,14">
                <StackPanel Spacing="10">

                    <!-- ═══════════ SYSTEM SECTION ═══════════ -->
                    <TextBlock Text="SYSTEM" FontSize="11" Foreground="#555555" FontWeight="Bold" Margin="0,2,0,0" />

                    <!-- CPU -->
                    <Border Background="#222222" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="CPU" FontSize="12" Foreground="#888888" FontWeight="Medium" />
                                <TextBlock x:Name="CpuPercentText" Text="0%" FontSize="12" Foreground="#64B5F6" Grid.Column="1" />
                            </Grid>
                            <ProgressBar x:Name="CpuBar"
                                         Minimum="0" Maximum="100" Value="0"
                                         Height="6" CornerRadius="3"
                                         Foreground="#64B5F6" Background="#333333" />
                        </StackPanel>
                    </Border>

                    <!-- Memory -->
                    <Border Background="#222222" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Memory" FontSize="12" Foreground="#888888" FontWeight="Medium" />
                                <TextBlock x:Name="MemoryText" Text="0 / 0 GB" FontSize="12" Foreground="#81C784" Grid.Column="1" />
                            </Grid>
                            <ProgressBar x:Name="MemoryBar"
                                         Minimum="0" Maximum="100" Value="0"
                                         Height="6" CornerRadius="3"
                                         Foreground="#81C784" Background="#333333" />
                        </StackPanel>
                    </Border>

                    <!-- Disk -->
                    <Border Background="#222222" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Disk (C:)" FontSize="12" Foreground="#888888" FontWeight="Medium" />
                                <TextBlock x:Name="DiskText" Text="0 / 0 GB" FontSize="12" Foreground="#FFB74D" Grid.Column="1" />
                            </Grid>
                            <ProgressBar x:Name="DiskBar"
                                         Minimum="0" Maximum="100" Value="0"
                                         Height="6" CornerRadius="3"
                                         Foreground="#FFB74D" Background="#333333" />
                        </StackPanel>
                    </Border>

                    <!-- Network -->
                    <Border Background="#222222" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Network" FontSize="12" Foreground="#888888" FontWeight="Medium" />
                            <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                                <TextBlock Text="↑" FontSize="14" Foreground="#EF5350" VerticalAlignment="Center" />
                                <TextBlock x:Name="NetworkUpText" Text="0 KB/s" FontSize="12" Foreground="#EF5350"
                                           Margin="6,0,0,0" VerticalAlignment="Center" Grid.Column="1" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Text="↓" FontSize="14" Foreground="#42A5F5" VerticalAlignment="Center" />
                                <TextBlock x:Name="NetworkDownText" Text="0 KB/s" FontSize="12" Foreground="#42A5F5"
                                           Margin="6,0,0,0" VerticalAlignment="Center" Grid.Column="1" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Uptime -->
                    <Border Background="#222222" CornerRadius="8" Padding="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="System Uptime" FontSize="12" Foreground="#888888" FontWeight="Medium" />
                            <TextBlock x:Name="UptimeText" Text="0d 0h 0m" FontSize="12" Foreground="#CE93D8" Grid.Column="1" />
                        </Grid>
                    </Border>

                    <!-- ═══════════ AI CREDITS SECTION ═══════════ -->
                    <TextBlock Text="AI CREDITS" FontSize="11" Foreground="#555555" FontWeight="Bold" Margin="0,6,0,0" />

                    <!-- OpenRouter -->
                    <Border x:Name="OpenRouterSection" Background="#222222" CornerRadius="8" Padding="12" IsVisible="False">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="OpenRouter" FontSize="12" Foreground="#888888" FontWeight="Medium" />
                                <TextBlock x:Name="OpenRouterCreditsText" Text="—" FontSize="12" Foreground="#4FC3F7" Grid.Column="1" />
                            </Grid>
                            <ProgressBar x:Name="OpenRouterBar"
                                         Minimum="0" Maximum="100" Value="0"
                                         Height="6" CornerRadius="3"
                                         Foreground="#4FC3F7" Background="#333333" />
                            <TextBlock x:Name="OpenRouterDetailText" Text="" FontSize="10" Foreground="#555555" />
                        </StackPanel>
                    </Border>

                    <!-- OpenAI -->
                    <Border x:Name="OpenAiSection" Background="#222222" CornerRadius="8" Padding="12" IsVisible="False">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="OpenAI" FontSize="12" Foreground="#888888" FontWeight="Medium" />
                                <TextBlock x:Name="OpenAiCreditsText" Text="—" FontSize="12" Foreground="#66BB6A" Grid.Column="1" />
                            </Grid>
                            <ProgressBar x:Name="OpenAiBar"
                                         Minimum="0" Maximum="100" Value="0"
                                         Height="6" CornerRadius="3"
                                         Foreground="#66BB6A" Background="#333333"
                                         IsVisible="False" />
                            <TextBlock x:Name="OpenAiDetailText" Text="" FontSize="10" Foreground="#555555" />
                        </StackPanel>
                    </Border>

                    <!-- Anthropic / Claude -->
                    <Border x:Name="AnthropicSection" Background="#222222" CornerRadius="8" Padding="12" IsVisible="False">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Anthropic" FontSize="12" Foreground="#888888" FontWeight="Medium" />
                                <TextBlock x:Name="AnthropicCreditsText" Text="—" FontSize="12" Foreground="#FF8A65" Grid.Column="1" />
                            </Grid>
                            <ProgressBar x:Name="AnthropicBar"
                                         Minimum="0" Maximum="100" Value="0"
                                         Height="6" CornerRadius="3"
                                         Foreground="#FF8A65" Background="#333333"
                                         IsVisible="False" />
                            <TextBlock x:Name="AnthropicDetailText" Text="" FontSize="10" Foreground="#555555" />
                        </StackPanel>
                    </Border>

                    <!-- Z.ai -->
                    <Border x:Name="ZaiSection" Background="#222222" CornerRadius="8" Padding="12" IsVisible="False">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Z.ai" FontSize="12" Foreground="#888888" FontWeight="Medium" />
                                <TextBlock x:Name="ZaiCreditsText" Text="—" FontSize="12" Foreground="#BA68C8" Grid.Column="1" />
                            </Grid>
                            <TextBlock x:Name="ZaiDetailText" Text="" FontSize="10" Foreground="#555555" />
                        </StackPanel>
                    </Border>

                    <!-- No API Keys Configured hint -->
                    <Border x:Name="NoKeysHint" Background="#1A1A1A" CornerRadius="8" Padding="12" IsVisible="True">
                        <StackPanel Spacing="4">
                            <TextBlock Text="No API keys configured" FontSize="11" Foreground="#666666" TextWrapping="Wrap" />
                            <TextBlock x:Name="ConfigPathText" Text="" FontSize="10" Foreground="#444444" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Border>
</Window>
