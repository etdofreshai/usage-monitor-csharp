<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UsageMonitor.UsagePopup"
        Title="Usage Monitor"
        Width="572"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

    <Border x:Name="OuterBorder"
            Background="#E6181818"
            CornerRadius="18"
            BorderBrush="#404040"
            BorderThickness="1"
            Padding="12">

        <Grid>
            <StackPanel x:Name="FullView" Spacing="5">

                <TextBlock Text="SYSTEM" FontSize="9" Foreground="#555555" FontWeight="Bold" Margin="0,1,0,0" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                        <Border Grid.Row="0" Grid.Column="0" Background="#222222" CornerRadius="8" Padding="8" Margin="0,0,3,3">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="CPU" FontSize="10" Foreground="#888888" FontWeight="Medium" />
                                    <TextBlock x:Name="CpuPercentText" Text="0%" FontSize="10" Foreground="#64B5F6" Grid.Column="1" TextAlignment="Right" />
                                </Grid>
                                <Grid x:Name="CpuBar" Height="4" ClipToBounds="True">
                                    <Border Background="#333333" CornerRadius="2" />
                                    <Border x:Name="CpuBarFill" Background="#64B5F6" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Background="#222222" CornerRadius="8" Padding="8" Margin="0,0,0,3">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Memory" FontSize="10" Foreground="#888888" FontWeight="Medium" />
                                    <TextBlock x:Name="MemoryPercentText" Text="0%" FontSize="10" Foreground="#81C784" Grid.Column="1" TextAlignment="Right" />
                                </Grid>
                                <Grid x:Name="MemoryBar" Height="4" ClipToBounds="True">
                                    <Border Background="#333333" CornerRadius="2" />
                                    <Border x:Name="MemoryBarFill" Background="#81C784" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
                                </Grid>
                                <TextBlock x:Name="MemoryText" Text="0 / 0 GB" FontSize="8" Foreground="#618F63" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="DriveSection" Grid.Row="1" Grid.ColumnSpan="2" Background="#222222" CornerRadius="8" Padding="8" Margin="0,0,0,3">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Drives" FontSize="10" Foreground="#888888" FontWeight="Medium" />
                                <StackPanel x:Name="FullDriveBarsHost" Spacing="3" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#222222" CornerRadius="8" Padding="8" Margin="0,0,0,3">
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,5,0">
                                    <TextBlock Text="Uptime" FontSize="10" Foreground="#888888" FontWeight="Medium" />
                                    <TextBlock x:Name="UptimeText" Text="0d 0h 0m" FontSize="11" Foreground="#CE93D8" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="2" Margin="5,0,0,0">
                                    <TextBlock Text="Net" FontSize="10" Foreground="#888888" FontWeight="Medium" />
                                    <TextBlock x:Name="NetworkUpText" Text="? 0 KB/s" FontSize="10" Foreground="#EF5350" />
                                    <TextBlock x:Name="NetworkDownText" Text="? 0 KB/s" FontSize="10" Foreground="#42A5F5" />
                                </StackPanel>
                            </Grid>
                        </Border>
                </Grid>

                <TextBlock Text="AI" FontSize="9" Foreground="#555555" FontWeight="Bold" Margin="0,3,0,0" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                    <Border x:Name="OpenRouterSection" Grid.Row="0" Grid.Column="0" Background="#222222" CornerRadius="8" Padding="8" Margin="0,0,3,0" IsVisible="False">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="OpenRouter" FontSize="10" Foreground="#888888" FontWeight="Medium" />
                                    <TextBlock x:Name="OpenRouterCreditsText" Text="—" FontSize="10" Foreground="#4FC3F7" Grid.Column="1" TextAlignment="Right" />
                                </Grid>
                                <TextBlock x:Name="OpenRouterRangeText" Text="" FontSize="8" Foreground="#555555" TextWrapping="Wrap" />
                                <Grid x:Name="OpenAiRow" ColumnDefinitions="*,Auto" IsVisible="False">
                                    <TextBlock Text="OpenAI" FontSize="10" Foreground="#888888" FontWeight="Medium" />
                                    <TextBlock x:Name="OpenAiCreditsText" Text="—" FontSize="10" Foreground="#10A37F" Grid.Column="1" TextAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CodexSection" Grid.Row="0" Grid.Column="1" Background="#222222" CornerRadius="8" Padding="8" Margin="3,0,0,0" IsVisible="False">
                            <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock x:Name="CodexTitleText" Text="Codex" FontSize="10" Foreground="#888888" FontWeight="Medium" />
                                    <TextBlock x:Name="CodexCreditsText" Text="—" FontSize="10" Foreground="#8BC34A" Grid.Column="1" TextAlignment="Right" />
                                </Grid>
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="28,*">
                                    <TextBlock x:Name="Codex5hLabel" Grid.Row="0" Grid.Column="0" Text="5h" FontSize="8" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,0,3" />
                                    <Grid x:Name="CodexPrimaryBar" Grid.Row="0" Grid.Column="1" Height="4" Margin="0,0,0,3" ClipToBounds="True">
                                        <Border Background="#333333" CornerRadius="2" />
                                        <Border x:Name="CodexPrimaryBarFill" Background="#8BC34A" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
                                        <Border x:Name="CodexPrimaryBarTick" Background="#FFFFFF" Width="2" HorizontalAlignment="Left" IsVisible="False" />
                                    </Grid>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="7d" FontSize="8" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,0,3" />
                                    <Grid x:Name="CodexSecondaryBar" Grid.Row="1" Grid.Column="1" Height="4" Margin="0,0,0,3" ClipToBounds="True">
                                        <Border Background="#333333" CornerRadius="2" />
                                        <Border x:Name="CodexSecondaryBarFill" Background="#B39DDB" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
                                        <Border x:Name="CodexSecondaryBarTick" Background="#FFFFFF" Width="2" HorizontalAlignment="Left" IsVisible="False" />
                                    </Grid>
                                    <TextBlock x:Name="CodexSpark5hLabel" Grid.Row="2" Grid.Column="0" Text="Sp5h" FontSize="8" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,0,3" IsVisible="False" />
                                    <Grid x:Name="CodexSparkPrimaryBar" Grid.Row="2" Grid.Column="1" Height="4" Margin="0,0,0,3" ClipToBounds="True" IsVisible="False">
                                        <Border Background="#333333" CornerRadius="2" />
                                        <Border x:Name="CodexSparkPrimaryBarFill" Background="#4DD0E1" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
                                        <Border x:Name="CodexSparkPrimaryBarTick" Background="#FFFFFF" Width="2" HorizontalAlignment="Left" IsVisible="False" />
                                    </Grid>
                                    <TextBlock x:Name="CodexSpark7dLabel" Grid.Row="3" Grid.Column="0" Text="Sp7d" FontSize="8" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,0,3" IsVisible="False" />
                                    <Grid x:Name="CodexSparkSecondaryBar" Grid.Row="3" Grid.Column="1" Height="4" Margin="0,0,0,3" ClipToBounds="True" IsVisible="False">
                                        <Border Background="#333333" CornerRadius="2" />
                                        <Border x:Name="CodexSparkSecondaryBarFill" Background="#4DB6AC" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
                                        <Border x:Name="CodexSparkSecondaryBarTick" Background="#FFFFFF" Width="2" HorizontalAlignment="Left" IsVisible="False" />
                                    </Grid>
                                    <TextBlock x:Name="CodexRangeText"
                                               Grid.Row="4" Grid.ColumnSpan="2"
                                               Text="" FontSize="8" Foreground="#555555" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="Codex2Section" Grid.Row="0" Grid.Column="1" Background="#222222" CornerRadius="8" Padding="8" Margin="3,0,0,0" IsVisible="False">
                            <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Codex #2" FontSize="10" Foreground="#888888" FontWeight="Medium" />
                                    <TextBlock x:Name="Codex2CreditsText" Text="—" FontSize="10" Foreground="#64B5F6" Grid.Column="1" TextAlignment="Right" />
                                </Grid>
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="28,*">
                                    <TextBlock x:Name="Codex2FiveHourLabel" Grid.Row="0" Grid.Column="0" Text="5h" FontSize="8" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,0,3" />
                                    <Grid x:Name="Codex2PrimaryBar" Grid.Row="0" Grid.Column="1" Height="4" Margin="0,0,0,3" ClipToBounds="True">
                                        <Border Background="#333333" CornerRadius="2" />
                                        <Border x:Name="Codex2PrimaryBarFill" Background="#64B5F6" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
                                        <Border x:Name="Codex2PrimaryBarTick" Background="#FFFFFF" Width="2" HorizontalAlignment="Left" IsVisible="False" />
                                    </Grid>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="7d" FontSize="8" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,0,3" />
                                    <Grid x:Name="Codex2SecondaryBar" Grid.Row="1" Grid.Column="1" Height="4" Margin="0,0,0,3" ClipToBounds="True">
                                        <Border Background="#333333" CornerRadius="2" />
                                        <Border x:Name="Codex2SecondaryBarFill" Background="#90CAF9" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
                                        <Border x:Name="Codex2SecondaryBarTick" Background="#FFFFFF" Width="2" HorizontalAlignment="Left" IsVisible="False" />
                                    </Grid>
                                    <TextBlock x:Name="Codex2SparkFiveHourLabel" Grid.Row="2" Grid.Column="0" Text="Sp5h" FontSize="8" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,0,3" IsVisible="False" />
                                    <Grid x:Name="Codex2SparkPrimaryBar" Grid.Row="2" Grid.Column="1" Height="4" Margin="0,0,0,3" ClipToBounds="True" IsVisible="False">
                                        <Border Background="#333333" CornerRadius="2" />
                                        <Border x:Name="Codex2SparkPrimaryBarFill" Background="#9575CD" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
                                        <Border x:Name="Codex2SparkPrimaryBarTick" Background="#FFFFFF" Width="2" HorizontalAlignment="Left" IsVisible="False" />
                                    </Grid>
                                    <TextBlock x:Name="Codex2SparkSevenDayLabel" Grid.Row="3" Grid.Column="0" Text="Sp7d" FontSize="8" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,0,3" IsVisible="False" />
                                    <Grid x:Name="Codex2SparkSecondaryBar" Grid.Row="3" Grid.Column="1" Height="4" Margin="0,0,0,3" ClipToBounds="True" IsVisible="False">
                                        <Border Background="#333333" CornerRadius="2" />
                                        <Border x:Name="Codex2SparkSecondaryBarFill" Background="#B39DDB" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
                                        <Border x:Name="Codex2SparkSecondaryBarTick" Background="#FFFFFF" Width="2" HorizontalAlignment="Left" IsVisible="False" />
                                    </Grid>
                                    <TextBlock x:Name="Codex2RangeText" Grid.Row="4" Grid.ColumnSpan="2" Text="" FontSize="8" Foreground="#555555" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ClaudeCodeSection" Grid.Row="1" Grid.Column="0" Background="#222222" CornerRadius="8" Padding="8" Margin="0,3,3,0" IsVisible="False">
                            <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Claude" FontSize="10" Foreground="#888888" FontWeight="Medium" />
                                    <TextBlock x:Name="ClaudeCodeCreditsText" Text="—" FontSize="10" Foreground="#FF8A65" Grid.Column="1" TextAlignment="Right" />
                                </Grid>
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="28,*">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="5h" FontSize="8" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,0,3" />
                                    <Grid x:Name="ClaudeCodePrimaryBar" Grid.Row="0" Grid.Column="1" Height="4" Margin="0,0,0,3" ClipToBounds="True">
                                        <Border Background="#333333" CornerRadius="2" />
                                        <Border x:Name="ClaudeCodePrimaryBarFill" Background="#FF8A65" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
                                        <Border x:Name="ClaudeCodePrimaryBarTick" Background="#FFFFFF" Width="2" HorizontalAlignment="Left" IsVisible="False" />
                                    </Grid>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="7d" FontSize="8" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,0,3" />
                                    <Grid x:Name="ClaudeCodeSecondaryBar" Grid.Row="1" Grid.Column="1" Height="4" Margin="0,0,0,3" ClipToBounds="True">
                                        <Border Background="#333333" CornerRadius="2" />
                                        <Border x:Name="ClaudeCodeSecondaryBarFill" Background="#FFB74D" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
                                        <Border x:Name="ClaudeCodeSecondaryBarTick" Background="#FFFFFF" Width="2" HorizontalAlignment="Left" IsVisible="False" />
                                    </Grid>
                                    <TextBlock x:Name="ClaudeDesignLabel" Grid.Row="2" Grid.Column="0" Text="Des" FontSize="8" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,0,3" IsVisible="False" />
                                    <Grid x:Name="ClaudeDesignBar" Grid.Row="2" Grid.Column="1" Height="4" Margin="0,0,0,3" ClipToBounds="True" IsVisible="False">
                                        <Border Background="#333333" CornerRadius="2" />
                                        <Border x:Name="ClaudeDesignBarFill" Background="#F48FB1" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
                                        <Border x:Name="ClaudeDesignBarTick" Background="#FFFFFF" Width="2" HorizontalAlignment="Left" IsVisible="False" />
                                    </Grid>
                                </Grid>
                                <TextBlock x:Name="ClaudeCodeRangeText" Text="" FontSize="8" Foreground="#555555" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="ClaudeCode2Section" Grid.Row="2" Grid.Column="0" Background="#222222" CornerRadius="8" Padding="8" Margin="0,3,3,0" IsVisible="False">
                            <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Claude 2" FontSize="10" Foreground="#888888" FontWeight="Medium" />
                                    <TextBlock x:Name="ClaudeCode2CreditsText" Text="—" FontSize="10" Foreground="#FF8A65" Grid.Column="1" TextAlignment="Right" />
                                </Grid>
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="28,*">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="5h" FontSize="8" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,0,3" />
                                    <Grid x:Name="ClaudeCode2PrimaryBar" Grid.Row="0" Grid.Column="1" Height="4" Margin="0,0,0,3" ClipToBounds="True">
                                        <Border Background="#333333" CornerRadius="2" />
                                        <Border x:Name="ClaudeCode2PrimaryBarFill" Background="#FF8A65" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
                                        <Border x:Name="ClaudeCode2PrimaryBarTick" Background="#FFFFFF" Width="2" HorizontalAlignment="Left" IsVisible="False" />
                                    </Grid>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="7d" FontSize="8" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,0,3" />
                                    <Grid x:Name="ClaudeCode2SecondaryBar" Grid.Row="1" Grid.Column="1" Height="4" Margin="0,0,0,3" ClipToBounds="True">
                                        <Border Background="#333333" CornerRadius="2" />
                                        <Border x:Name="ClaudeCode2SecondaryBarFill" Background="#FFB74D" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
                                        <Border x:Name="ClaudeCode2SecondaryBarTick" Background="#FFFFFF" Width="2" HorizontalAlignment="Left" IsVisible="False" />
                                    </Grid>
                                    <TextBlock x:Name="ClaudeDesign2Label" Grid.Row="2" Grid.Column="0" Text="Des" FontSize="8" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,0,3" IsVisible="False" />
                                    <Grid x:Name="ClaudeDesign2Bar" Grid.Row="2" Grid.Column="1" Height="4" Margin="0,0,0,3" ClipToBounds="True" IsVisible="False">
                                        <Border Background="#333333" CornerRadius="2" />
                                        <Border x:Name="ClaudeDesign2BarFill" Background="#F48FB1" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
                                        <Border x:Name="ClaudeDesign2BarTick" Background="#FFFFFF" Width="2" HorizontalAlignment="Left" IsVisible="False" />
                                    </Grid>
                                </Grid>
                                <TextBlock x:Name="ClaudeCode2RangeText" Text="" FontSize="8" Foreground="#555555" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="ZaiSection" Grid.Row="1" Grid.Column="1" Background="#222222" CornerRadius="8" Padding="8" Margin="3,3,0,0" IsVisible="False">
                            <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Z.ai" FontSize="10" Foreground="#888888" FontWeight="Medium" />
                                    <TextBlock x:Name="ZaiCreditsText" Text="—" FontSize="10" Foreground="#BA68C8" Grid.Column="1" TextAlignment="Right" />
                                </Grid>
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="22,*">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="5h" FontSize="8" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,0,3" />
                                    <Grid x:Name="ZaiTokenBar" Grid.Row="0" Grid.Column="1" Height="4" Margin="0,0,0,3" ClipToBounds="True">
                                        <Border Background="#333333" CornerRadius="2" />
                                        <Border x:Name="ZaiTokenBarFill" Background="#BA68C8" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
                                        <Border x:Name="ZaiTokenBarTick" Background="#FFFFFF" Width="2" HorizontalAlignment="Left" IsVisible="False" />
                                    </Grid>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Month" FontSize="8" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,0,3" />
                                    <Grid x:Name="ZaiMonthlyBar" Grid.Row="1" Grid.Column="1" Height="4" Margin="0,0,0,3" ClipToBounds="True">
                                        <Border Background="#333333" CornerRadius="2" />
                                        <Border x:Name="ZaiMonthlyBarFill" Background="#7E57C2" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
                                        <Border x:Name="ZaiMonthlyBarTick" Background="#FFFFFF" Width="2" HorizontalAlignment="Left" IsVisible="False" />
                                    </Grid>
                                    <TextBlock x:Name="ZaiDetailText" Grid.Row="2" Grid.ColumnSpan="2" Text="" FontSize="8" Foreground="#555555" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ZaiTokenText" Grid.Row="3" Grid.ColumnSpan="2" Text="" FontSize="8" Foreground="#555555" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="NoKeysHint" Background="#1A1A1A" CornerRadius="8" Padding="10" IsVisible="True">
                        <StackPanel Spacing="3">
                            <TextBlock Text="No API keys configured" FontSize="10" Foreground="#666666" TextWrapping="Wrap" />
                            <TextBlock x:Name="ConfigPathText" Text="" FontSize="9" Foreground="#444444" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="BuildInfoText"
                               Text=""
                               FontSize="8"
                               Foreground="#555555"
                               HorizontalAlignment="Right"
                               Margin="0,2,0,0" />

                </StackPanel>

            <Border x:Name="CompactView"
                    IsVisible="False"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Width="240"
                    Background="#E6181818"
                    CornerRadius="18"
                    BorderBrush="#404040"
                    BorderThickness="1"
                    Padding="10,6,10,8">
                <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="MonitorTitleText"
                                   Text="Monitor"
                                   FontSize="9"
                                   Foreground="#777777"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Cursor="Hand"
                                   ToolTip.Tip="Open usage dashboard" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                            <Button x:Name="UpdateButtonCompact"
                                    Width="22" Height="22"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="11"
                                    Padding="0"
                                    IsVisible="False"
                                    ToolTip.Tip="Update available - click to update and restart">
                                <TextBlock Text="&#x21BB;"
                                           FontSize="14"
                                           Foreground="#4CAF50"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="RestoreFullButton"
                                    Width="22" Height="22"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="11"
                                    Padding="0"
                                    ToolTip.Tip="Restore full">
                                <Image x:Name="RestoreFullIcon"
                                       Width="16"
                                       Height="16" />
                            </Button>
                            <Button x:Name="CloseCompactButton"
                                    Width="22" Height="22"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="11"
                                    Padding="0"
                                    ToolTip.Tip="Close">
                                <Path Data="M18.3,5.71 L12,12 L5.71,5.71 M5.71,18.29 L12,12 L18.3,18.29"
                                      Stroke="#888888"
                                      StrokeThickness="2"
                                      Width="12" Height="12"
                                      Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- System utilization bars -->
                    <Grid ColumnDefinitions="58,68,42,48" ClipToBounds="True">
                        <TextBlock Text="CPU" FontSize="9" Foreground="#64B5F6" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Grid Grid.Column="1" Width="62" Height="4" Margin="2,0,4,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Border Background="#333333" CornerRadius="2" />
                            <Border x:Name="CpuCompactBar" Background="#64B5F6" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
                        </Grid>
                        <TextBlock x:Name="CpuCompactText" Text="—" FontSize="8" Foreground="#AAD4FA" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="58,68,42,48" ClipToBounds="True">
                        <TextBlock Text="Memory" FontSize="9" Foreground="#81C784" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Grid Grid.Column="1" Width="62" Height="4" Margin="2,0,4,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Border Background="#333333" CornerRadius="2" />
                            <Border x:Name="MemoryCompactBar" Background="#81C784" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
                        </Grid>
                        <TextBlock x:Name="MemoryCompactText" Text="—" FontSize="8" Foreground="#B8E0BA" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel x:Name="CompactDriveBarsHost" Spacing="1" />
                    <Grid ColumnDefinitions="50,*">
                        <TextBlock Text="Uptime" FontSize="9" Foreground="#CE93D8" FontWeight="SemiBold" />
                        <TextBlock x:Name="UptimeCompactText" Text="—" FontSize="8" Foreground="#E4C5EC" Grid.Column="1" HorizontalAlignment="Right" TextAlignment="Right" />
                    </Grid>
                    <Grid ColumnDefinitions="50,*">
                        <TextBlock Text="Net" FontSize="9" Foreground="#EF5350" FontWeight="SemiBold" />
                        <TextBlock x:Name="NetCompactText" Text="—" FontSize="8" Foreground="#F5A8A6" Grid.Column="1" HorizontalAlignment="Right" TextAlignment="Right" />
                    </Grid>

                    <!-- Separator -->
                    <Border Height="1" Background="#333333" Margin="0,2" />

                    <!-- AI one-liners -->
                    <Grid x:Name="OpenRouterCompactSection" ColumnDefinitions="62,*">
                        <TextBlock Text="OpenRouter" FontSize="9" Foreground="#4FC3F7" FontWeight="SemiBold" />
                        <TextBlock x:Name="OpenRouterCompactText" Text="—" FontSize="8" Foreground="#BDEEFF" Grid.Column="1" HorizontalAlignment="Right" TextAlignment="Right" />
                    </Grid>
                    <Grid x:Name="OpenAiCompactRow" ColumnDefinitions="62,*" IsVisible="False">
                        <TextBlock Text="OpenAI" FontSize="9" Foreground="#10A37F" FontWeight="SemiBold" />
                        <TextBlock x:Name="OpenAiCompactText" Text="—" FontSize="8" Foreground="#7DD4B8" Grid.Column="1" HorizontalAlignment="Right" TextAlignment="Right" />
