<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UsageMonitor.UsagePopup"
        Title="Usage Monitor"
        Width="572"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

    <Border x:Name="OuterBorder"
            Background="#E6181818"
            CornerRadius="18"
            BorderBrush="#404040"
            BorderThickness="1"
            Padding="12">

        <Grid>
            <StackPanel x:Name="FullView" Spacing="5">

                <TextBlock Text="SYSTEM" FontSize="9" Foreground="#555555" FontWeight="Bold" Margin="0,1,0,0" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                        <Border Grid.Row="0" Grid.Column="0" Background="#222222" CornerRadius="8" Padding="8" Margin="0,0,3,3">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="CPU" FontSize="10" Foreground="#888888" FontWeight="Medium" />
                                    <TextBlock x:Name="CpuPercentText" Text="0%" FontSize="10" Foreground="#64B5F6" Grid.Column="1" TextAlignment="Right" />
                                </Grid>
                                <ProgressBar x:Name="CpuBar"
                                             Minimum="0" Maximum="100" Value="0"
                                             Height="4" CornerRadius="2"
                                             Foreground="#64B5F6" Background="#333333" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Background="#222222" CornerRadius="8" Padding="8" Margin="0,0,0,3">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Memory" FontSize="10" Foreground="#888888" FontWeight="Medium" />
                                <TextBlock x:Name="MemoryText" Text="0 / 0 GB" FontSize="10" Foreground="#81C784" />
                                <ProgressBar x:Name="MemoryBar"
                                             Minimum="0" Maximum="100" Value="0"
                                             Height="4" CornerRadius="2"
                                             Foreground="#81C784" Background="#333333" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Background="#222222" CornerRadius="8" Padding="8" Margin="0,0,3,3">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Disk" FontSize="10" Foreground="#888888" FontWeight="Medium" />
                                <TextBlock x:Name="DiskText" Text="0 / 0 GB" FontSize="10" Foreground="#FFB74D" />
                                <ProgressBar x:Name="DiskBar"
                                             Minimum="0" Maximum="100" Value="0"
                                             Height="4" CornerRadius="2"
                                             Foreground="#FFB74D" Background="#333333" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Background="#222222" CornerRadius="8" Padding="8" Margin="0,0,0,3">
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,5,0">
                                    <TextBlock Text="Uptime" FontSize="10" Foreground="#888888" FontWeight="Medium" />
                                    <TextBlock x:Name="UptimeText" Text="0d 0h 0m" FontSize="11" Foreground="#CE93D8" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="2" Margin="5,0,0,0">
                                    <TextBlock Text="Net" FontSize="10" Foreground="#888888" FontWeight="Medium" />
                                    <TextBlock x:Name="NetworkUpText" Text="? 0 KB/s" FontSize="10" Foreground="#EF5350" />
                                    <TextBlock x:Name="NetworkDownText" Text="? 0 KB/s" FontSize="10" Foreground="#42A5F5" />
                                </StackPanel>
                            </Grid>
                        </Border>
                </Grid>

                <TextBlock Text="AI" FontSize="9" Foreground="#555555" FontWeight="Bold" Margin="0,3,0,0" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                    <Border x:Name="OpenRouterSection" Grid.Row="0" Grid.Column="0" Background="#222222" CornerRadius="8" Padding="8" Margin="0,0,3,0" IsVisible="False">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="OpenRouter" FontSize="10" Foreground="#888888" FontWeight="Medium" />
                                    <TextBlock x:Name="OpenRouterCreditsText" Text="—" FontSize="10" Foreground="#4FC3F7" Grid.Column="1" TextAlignment="Right" />
                                </Grid>
                                <TextBlock x:Name="OpenRouterRangeText" Text="" FontSize="8" Foreground="#555555" TextWrapping="Wrap" />
                                <Grid x:Name="OpenAiRow" ColumnDefinitions="*,Auto" IsVisible="False">
                                    <TextBlock Text="OpenAI" FontSize="10" Foreground="#888888" FontWeight="Medium" />
                                    <TextBlock x:Name="OpenAiCreditsText" Text="—" FontSize="10" Foreground="#10A37F" Grid.Column="1" TextAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CodexSection" Grid.Row="0" Grid.Column="1" Background="#222222" CornerRadius="8" Padding="8" Margin="3,0,0,0" IsVisible="False">
                            <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Codex" FontSize="10" Foreground="#888888" FontWeight="Medium" />
                                    <TextBlock x:Name="CodexCreditsText" Text="—" FontSize="10" Foreground="#8BC34A" Grid.Column="1" TextAlignment="Right" />
                                </Grid>
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="22,*">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="5h" FontSize="8" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,0,3" />
                                    <ProgressBar x:Name="CodexPrimaryBar"
                                                 Grid.Row="0" Grid.Column="1"
                                                 Minimum="0" Maximum="100" Value="0"
                                                 Height="4" CornerRadius="2" Margin="0,0,0,3"
                                                 Foreground="#8BC34A" Background="#333333" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="7d" FontSize="8" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,0,3" />
                                    <ProgressBar x:Name="CodexSecondaryBar"
                                                 Grid.Row="1" Grid.Column="1"
                                                 Minimum="0" Maximum="100" Value="0"
                                                 Height="4" CornerRadius="2" Margin="0,0,0,3"
                                                 Foreground="#B39DDB" Background="#333333" />
                                    <TextBlock x:Name="CodexRangeText"
                                               Grid.Row="2" Grid.ColumnSpan="2"
                                               Text="" FontSize="8" Foreground="#555555" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ClaudeCodeSection" Grid.Row="1" Grid.Column="0" Background="#222222" CornerRadius="8" Padding="8" Margin="0,3,3,0" IsVisible="False">
                            <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Claude" FontSize="10" Foreground="#888888" FontWeight="Medium" />
                                    <TextBlock x:Name="ClaudeCodeCreditsText" Text="—" FontSize="10" Foreground="#FF8A65" Grid.Column="1" TextAlignment="Right" />
                                </Grid>
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="22,*">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="5h" FontSize="8" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,0,3" />
                                    <ProgressBar x:Name="ClaudeCodePrimaryBar"
                                                 Grid.Row="0" Grid.Column="1"
                                                 Minimum="0" Maximum="100" Value="0"
                                                 Height="4" CornerRadius="2" Margin="0,0,0,3"
                                                 Foreground="#FF8A65" Background="#333333" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="7d" FontSize="8" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,0,3" />
                                    <ProgressBar x:Name="ClaudeCodeSecondaryBar"
                                                 Grid.Row="1" Grid.Column="1"
                                                 Minimum="0" Maximum="100" Value="0"
                                                 Height="4" CornerRadius="2" Margin="0,0,0,3"
                                                 Foreground="#FFB74D" Background="#333333" />
                                </Grid>
                                <TextBlock x:Name="ClaudeCodeRangeText" Text="" FontSize="8" Foreground="#555555" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="ZaiSection" Grid.Row="1" Grid.Column="1" Background="#222222" CornerRadius="8" Padding="8" Margin="3,3,0,0" IsVisible="False">
                            <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Z.ai" FontSize="10" Foreground="#888888" FontWeight="Medium" />
                                    <TextBlock x:Name="ZaiCreditsText" Text="—" FontSize="10" Foreground="#BA68C8" Grid.Column="1" TextAlignment="Right" />
                                </Grid>
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="22,*">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="5h" FontSize="8" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,0,3" />
                                    <ProgressBar x:Name="ZaiTokenBar"
                                                 Grid.Row="0" Grid.Column="1"
                                                 Minimum="0" Maximum="100" Value="0"
                                                 Height="4" CornerRadius="2" Margin="0,0,0,3"
                                                 Foreground="#BA68C8" Background="#333333" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Month" FontSize="8" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,0,3" />
                                    <ProgressBar x:Name="ZaiMonthlyBar"
                                                 Grid.Row="1" Grid.Column="1"
                                                 Minimum="0" Maximum="100" Value="0"
                                                 Height="4" CornerRadius="2" Margin="0,0,0,3"
                                                 Foreground="#7E57C2" Background="#333333" />
                                    <TextBlock x:Name="ZaiDetailText" Grid.Row="2" Grid.ColumnSpan="2" Text="" FontSize="8" Foreground="#555555" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ZaiTokenText" Grid.Row="3" Grid.ColumnSpan="2" Text="" FontSize="8" Foreground="#555555" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="NoKeysHint" Background="#1A1A1A" CornerRadius="8" Padding="10" IsVisible="True">
                        <StackPanel Spacing="3">
                            <TextBlock Text="No API keys configured" FontSize="10" Foreground="#666666" TextWrapping="Wrap" />
                            <TextBlock x:Name="ConfigPathText" Text="" FontSize="9" Foreground="#444444" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                </StackPanel>

            <Border x:Name="CompactView"
                    IsVisible="False"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Width="210"
                    Background="#E6181818"
                    CornerRadius="18"
                    BorderBrush="#404040"
                    BorderThickness="1"
                    Padding="10,6,10,8">
                <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Monitor"
                                   FontSize="9"
                                   Foreground="#555555"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <Button x:Name="RestoreFullButton"
                                Grid.Column="1"
                                Width="22" Height="22"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="11"
                                Padding="0"
                                ToolTip.Tip="Restore full">
                            <Image x:Name="RestoreFullIcon"
                                   Width="16"
                                   Height="16" />
                        </Button>
                    </Grid>

                    <!-- System one-liners -->
                    <Grid ColumnDefinitions="50,*">
                        <TextBlock Text="CPU" FontSize="9" Foreground="#64B5F6" FontWeight="SemiBold" />
                        <TextBlock x:Name="CpuCompactText" Text="—" FontSize="8" Foreground="#AAD4FA" Grid.Column="1" HorizontalAlignment="Right" TextAlignment="Right" />
                    </Grid>
                    <Grid ColumnDefinitions="50,*">
                        <TextBlock Text="Memory" FontSize="9" Foreground="#81C784" FontWeight="SemiBold" />
                        <TextBlock x:Name="MemoryCompactText" Text="—" FontSize="8" Foreground="#B8E0BA" Grid.Column="1" HorizontalAlignment="Right" TextAlignment="Right" />
                    </Grid>
                    <Grid ColumnDefinitions="50,*">
                        <TextBlock Text="Disk" FontSize="9" Foreground="#FFB74D" FontWeight="SemiBold" />
                        <TextBlock x:Name="DiskCompactText" Text="—" FontSize="8" Foreground="#FFDAA6" Grid.Column="1" HorizontalAlignment="Right" TextAlignment="Right" />
                    </Grid>
                    <Grid ColumnDefinitions="50,*">
                        <TextBlock Text="Uptime" FontSize="9" Foreground="#CE93D8" FontWeight="SemiBold" />
                        <TextBlock x:Name="UptimeCompactText" Text="—" FontSize="8" Foreground="#E4C5EC" Grid.Column="1" HorizontalAlignment="Right" TextAlignment="Right" />
                    </Grid>
                    <Grid ColumnDefinitions="50,*">
                        <TextBlock Text="Net" FontSize="9" Foreground="#EF5350" FontWeight="SemiBold" />
                        <TextBlock x:Name="NetCompactText" Text="—" FontSize="8" Foreground="#F5A8A6" Grid.Column="1" HorizontalAlignment="Right" TextAlignment="Right" />
                    </Grid>

                    <!-- Separator -->
                    <Border Height="1" Background="#333333" Margin="0,2" />

                    <!-- AI one-liners -->
                    <Grid x:Name="OpenRouterCompactSection" ColumnDefinitions="62,*">
                        <TextBlock Text="OpenRouter" FontSize="9" Foreground="#4FC3F7" FontWeight="SemiBold" />
                        <TextBlock x:Name="OpenRouterCompactText" Text="—" FontSize="8" Foreground="#BDEEFF" Grid.Column="1" HorizontalAlignment="Right" TextAlignment="Right" />
                    </Grid>
                    <Grid x:Name="OpenAiCompactRow" ColumnDefinitions="62,*" IsVisible="False">
                        <TextBlock Text="OpenAI" FontSize="9" Foreground="#10A37F" FontWeight="SemiBold" />
                        <TextBlock x:Name="OpenAiCompactText" Text="—" FontSize="8" Foreground="#7DD4B8" Grid.Column="1" HorizontalAlignment="Right" TextAlignment="Right" />
                    </Grid>
                    <Grid x:Name="CodexCompactSection" ColumnDefinitions="62,*">
                        <TextBlock Text="Codex" FontSize="9" Foreground="#8BC34A" FontWeight="SemiBold" />
                        <TextBlock x:Name="CodexCompactText" Text="—" FontSize="8" Foreground="#D3F2A3" Grid.Column="1" HorizontalAlignment="Right" TextAlignment="Right" />
                    </Grid>
                    <Grid x:Name="ClaudeCompactSection" ColumnDefinitions="62,*">
                        <TextBlock Text="Claude" FontSize="9" Foreground="#FF8A65" FontWeight="SemiBold" />
                        <TextBlock x:Name="ClaudeCompactText" Text="—" FontSize="8" Foreground="#FFD3C0" Grid.Column="1" HorizontalAlignment="Right" TextAlignment="Right" />
                    </Grid>
                    <Grid x:Name="ZaiCompactSection" ColumnDefinitions="62,*">
                        <TextBlock Text="Z.ai" FontSize="9" Foreground="#BA68C8" FontWeight="SemiBold" />
                        <TextBlock x:Name="ZaiCompactText" Text="—" FontSize="8" Foreground="#E1C5EA" Grid.Column="1" HorizontalAlignment="Right" TextAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="IconOnlyView"
                    IsVisible="False"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Width="54"
                    Height="54"
                    Background="#E6181818"
                    CornerRadius="16"
                    BorderBrush="#404040"
                    BorderThickness="1"
                    Padding="6">
                <Button x:Name="RestoreIconButton"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ToolTip.Tip="Restore full">
                    <Image x:Name="RestoreIconImage"
                           Width="26"
                           Height="26"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                </Button>
            </Border>

            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        Spacing="4">
                <Button x:Name="CompactButton"
                        Width="28" Height="24"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="12"
                        Padding="0"
                        ToolTip.Tip="Compact AI view">
                    <TextBlock Text="AI"
                               FontSize="10"
                               Foreground="#B0B0B0"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>

                <Button x:Name="IconOnlyButton"
                        Width="24" Height="24"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="12"
                        Padding="0"
                        ToolTip.Tip="Icon only view">
                    <Image x:Name="IconOnlyButtonImage"
                           Width="14"
                           Height="14" />
                </Button>

                <Button x:Name="CloseButton"
                        Width="24" Height="24"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="13"
                        Padding="0"
                        ToolTip.Tip="Close">
                    <Path Data="M18.3,5.71 L12,12 L5.71,5.71 M5.71,18.29 L12,12 L18.3,18.29"
                          Stroke="#888888"
                          StrokeThickness="2"
                          Width="14" Height="14"
                          Stretch="Uniform" />
                </Button>
            </StackPanel>

        </Grid>
    </Border>
</Window>

